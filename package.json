        {
          "command": "VSKit.openHelpGrid",
          "when": "true",
          "group": "VSKitHelp"
        }
      ],
      "webview/VSKit.results/context": [
        {
          "command": "VSKit.openHelpGrid",
          "when": "true",
          "group": "VSKitHelp"
        }
      ],
