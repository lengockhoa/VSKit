        {
          "command": "VSKit.openHelpGrid",
          "when": "true",
          "group": "VSKitHelp"
        }
      ],
      "editor/title": [
        {
          "command": "VSKit.selectActiveSchema",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation"
        },
        {
          "command": "VSKit.runQuery",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation"
        },
        {
          "command": "VSKit.cancelQuery",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation"
        },
        {
          "command": "VSKit.runScript",
          "when": "resourceLangId == shellscript",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "VSKit.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/item/context": [
        {
          "command": "VSKit.generateSelect",
          "when": "view == VSKit.schemaTree && (viewItem == table || viewItem == view)",
          "group": "inline"
        },
        {
          "command": "VSKit.copyQualifiedName",
          "when": "view == VSKit.schemaTree && (viewItem == table || viewItem == view || viewItem == column || viewItem == routine)",
          "group": "inline"
        },
        {
          "command": "VSKit.openConsoleForObject",
          "when": "view == VSKit.schemaTree && (viewItem == connection || viewItem == schema || viewItem == category || viewItem == table || viewItem == view)",
          "group": "inline"
        },
        {
          "command": "VSKit.refreshSchema",
          "when": "view == VSKit.schemaTree",
          "group": "VSKit"
        },
        {
          "command": "VSKit.editConnection",
          "when": "view == VSKit.schemaTree && viewItem == connection",
          "group": "VSKit"
        },
        {
          "command": "VSKit.deleteConnection",
          "when": "view == VSKit.schemaTree && viewItem == connection",
          "group": "VSKit"
        },
        {
          "command": "VSKit.selectSchemas",
          "when": "view == VSKit.schemaTree && viewItem == connection",
          "group": "VSKit"
        },
        {
          "command": "VSKit.resetSchemaFilter",
          "when": "view == VSKit.schemaTree && viewItem == connection",
          "group": "VSKit"
        },
        {
          "command": "VSKit.newTable",
          "when": "view == VSKit.schemaTree && (viewItem == schema || viewItem == category || viewItem == table)",
          "group": "1_table@01"
        },
        {
          "command": "VSKit.modifyTable",
          "when": "view == VSKit.schemaTree && viewItem == table",
          "group": "1_table@02"
        },
        {
          "command": "VSKit.renameTable",
          "when": "view == VSKit.schemaTree && viewItem == table",
          "group": "1_table@03"
        },
        {
          "command": "VSKit.renameColumn",
          "when": "view == VSKit.schemaTree && (viewItem == table || viewItem == column)",
          "group": "1_table@04"
        },
        {
          "command": "VSKit.copyCreateDdl",
          "when": "view == VSKit.schemaTree && viewItem == table",
          "group": "1_table@05"
        },
        {
          "command": "VSKit.generateSampleData",
          "when": "view == VSKit.schemaTree && viewItem == table",
          "group": "1_table@06"
        },
        {
          "command": "VSKit.analyzeTable",
          "when": "view == VSKit.schemaTree && viewItem == table",
          "group": "1_table@07"
        },
        {
          "command": "VSKit.vacuumTable",
          "when": "view == VSKit.schemaTree && viewItem == table",
          "group": "1_table@08"
        },
        {
          "command": "VSKit.createSchema",
          "when": "view == VSKit.schemaTree && (viewItem == connection || viewItem == schema)",
          "group": "VSKit"
        },
        {
          "command": "VSKit.postmanPayload",
          "when": "view == VSKit.schemaTree && (viewItem == table || viewItem == view || viewItem == routine)",
          "group": "1_table@09"
        },
        {
          "command": "VSKit.exportStructure",
          "when": "view == VSKit.schemaTree && (viewItem == table || viewItem == view)",
          "group": "1_table@10"
        },
        {
          "command": "VSKit.exportAllStructures",
          "when": "view == VSKit.schemaTree && (viewItem == connection || viewItem == schema)",
          "group": "VSKit"
        },
        {
          "command": "VSKit.generateViewDdl",
          "when": "view == VSKit.schemaTree && viewItem == view",
          "group": "VSKit"
        },
        {
          "command": "VSKit.generateFunctionDdl",
          "when": "view == VSKit.schemaTree && viewItem == routine",
          "group": "VSKit"
        }
      ],
      "view/title": [
        {
          "command": "VSKit.openConsole",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        },
        {
          "command": "VSKit.refreshSchema",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        },
        {
          "command": "VSKit.openAiSettings",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        },
        {
          "command": "VSKit.addConnection",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        },
        {
          "command": "VSKit.filterSchemaTree",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        },
        {
          "command": "VSKit.aiChat",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        },
        {
          "command": "VSKit.clearSchemaTreeFilter",
          "when": "view == VSKit.schemaTree && VSKit.schemaTreeFilterActive",
          "group": "navigation"
        },
        {
          "command": "VSKit.openSettings",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        },
        {
          "command": "VSKit.openUserGuide",
          "when": "view == VSKit.schemaTree",
          "group": "navigation"
        }
      ]
    },
