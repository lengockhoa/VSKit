      {
        "command": "VSKit.runQuery",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      },
      {
        "command": "VSKit.runQuery",
        "key": "ctrl+enter",
        "win": "ctrl+enter",
        "linux": "ctrl+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      },
      {
        "command": "VSKit.runShellSelection",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceLangId == shellscript"
      },
