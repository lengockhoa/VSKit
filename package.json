{
  "name": "vskit",
  "displayName": "VSKit — Run SQL from VS Code",
  "description": "Run SQL against PostgreSQL, MySQL/MariaDB and SQL Server directly from VS Code. Cmd+Enter (macOS) / Ctrl+Enter (Win/Linux) executes the selected statement.",
  "version": "1.55.16",
  "publisher": "lengockhoa",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "icon": "media/icon.png",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "postgresql",
    "mysql",
    "mariadb",
    "mssql",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lengockhoa/VSKit"
  },
  "bugs": {
    "url": "https://github.com/lengockhoa/VSKit/issues"
  },
  "homepage": "https://github.com/lengockhoa/VSKit#readme",
  "activationEvents": [
    "onLanguage:sql",
    "onCommand:VSKit.addConnection",
    "onCommand:VSKit.editConnection",
    "onCommand:VSKit.deleteConnection",
    "onCommand:VSKit.selectConnection",
    "onCommand:VSKit.runQuery",
    "onCommand:VSKit.cancelQuery",
    "onCommand:VSKit.generateSelect",
    "onCommand:VSKit.copyQualifiedName",
    "onCommand:VSKit.refreshSchema",
    "onCommand:VSKit.runScript",
    "onLanguage:shellscript",
    "onCommand:VSKit.runShellSelection",
    "onCommand:VSKit.runStatement",
    "onCommand:VSKit.newTable",
    "onCommand:VSKit.modifyTable",
    "onCommand:VSKit.copyCreateDdl",
    "onCommand:VSKit.generateSampleData",
    "onCommand:VSKit.analyzeTable",
    "onCommand:VSKit.vacuumTable",
    "onCommand:VSKit.openAiSettings",
    "onCommand:VSKit.openUserGuide",
    "onCommand:VSKit.aiChat",
    "onCommand:VSKit.ai.useWithOmp",
    "onCommand:VSKit.ai.useWithClaudeCode",
    "onCommand:VSKit.ai.useWithCodex",
    "onCommand:VSKit.ai.refreshDbContext",
    "onCommand:VSKit.ai.showPolicy",
    "onCommand:VSKit.ai.exportTrace",
    "onCommand:VSKit.ai.clearTrace",
    "onCommand:VSKit.browseTableData",
    "onCommand:VSKit.renameTable",
    "onCommand:VSKit.renameColumn",
    "onCommand:VSKit.createSchema",
    "onCommand:VSKit.exportStructure",
    "onCommand:VSKit.exportAllStructures",
    "onCommand:VSKit.openConsole",
    "onCommand:VSKit.consoleNewTab",
    "onCommand:VSKit.refreshAdmin",
    "onCommand:VSKit.openSessionsPanel",
    "onCommand:VSKit.importCsv",
    "onCommand:VSKit.importJson",
    "onCommand:VSKit.openFormView",
    "onCommand:VSKit.editLargeValue",
    "onCommand:VSKit.diagnostics.show",
    "onCommand:VSKit.diagnostics.clear",
    "onCommand:VSKit.generateViewDdl",
    "onCommand:VSKit.generateFunctionDdl",
    "onCommand:VSKit.openSettings",
    "onView:VSKit.results"
