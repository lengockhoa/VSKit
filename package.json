      }
    ],
    "configuration": {
      "title": "VSKit",
      "properties": {
        "VSKit.showRunLens": {
          "type": "boolean",
          "default": true,
          "description": "Hiển thị CodeLens ▶ Run phía trên mỗi SQL statement trong file .sql."
        },
        "VSKit.import.batchSize": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Rows per INSERT statement during CSV/JSON import (DBX-01)."
        },
        "VSKit.showRunLensSh": {
          "type": "boolean",
          "default": true,
          "description": "Hiển thị CodeLens ▶ Run ở đầu file .sh (shellscript)."
        },
        "VSKit.batchSize": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 10000,
          "description": "Số rows tải về mỗi lần (Load 500 more)."
        },
        "VSKit.queryTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Auto-stop a SQL statement that runs longer than this many seconds — cancels the batch, aborts the connection work, and reports the error. 0 disables the watchdog."
        },
        "VSKit.admin.confirmGrant": {
          "type": "boolean",
          "default": true,
          "description": "TASK-AHL-004 — ask for confirmation before running GRANT/REVOKE/KILL/TERMINATE statements (admin DCL). Always ON by default; set to false to skip the confirm modal at your own risk."
        },
        "VSKit.confirmDestructive": {
          "type": "boolean",
          "default": true,
          "description": "Hỏi xác nhận trước khi chạy câu lệnh phá hoại (DELETE/UPDATE không WHERE, TRUNCATE, DROP)."
        },
        "VSKit.hideSystemSchemas": {
          "type": "boolean",
          "default": true,
          "description": "Hide system schemas such as pg_catalog and information_schema in the Schema Explorer."
        },
        "VSKit.preferPrimarySidebar": {
          "type": "boolean",
          "default": true,
          "description": "v1.53.32 — when true (default), on first activation VSKit moves its view container to the Primary Sidebar (left activity bar) instead of staying in the Secondary Sidebar (right). Set to false if you prefer the Secondary Sidebar placement. Re-run \"VSKit: Move to Primary Sidebar\" from the command palette to apply after toggling."
        },
        "VSKit.ai.engine": {
          "type": "string",
          "enum": [
            "builtin",
            "omp",
            "claude-code",
            "codex"
          ],
          "default": "omp",
          "description": "Select the AI chat engine (`builtin`, `omp`, `claude-code`, or `codex`). If the selected external engine is unavailable, VSKit falls back to builtin with a notification."
        },
        "VSKit.ai.grounding": {
          "type": "boolean",
          "default": false,
          "description": "Allow AI chat to use workspace files as additional grounding context, limited to the extension's curated allowlist."
        },
        "VSKit.ai.commitGenDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Write metadata-only commit-message generation timings to the VSKit: Commit Message Diagnostics Output Channel."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "source.sql.vskit",
        "path": "./syntaxes/vskit-sql-injection.tmLanguage.json",
        "injectTo": [
          "source.sql"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "verify:fast": "npm run typecheck && npm run compile",
    "verify:release": "npm test && npm run typecheck && npm run compile",
    "profile:fast": "npm run typecheck && npm run compile",
    "profile:release": "npm run verify:release",
    "vscode:prepublish": "npm run compile"
  },
